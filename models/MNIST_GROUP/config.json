{
  "target_dataset": "MNIST",
  "batch_size": 128,
  "num_epochs": 10,
  "learning_rate": 0.001,
  "learning_rate_lambdas": 0.001,
  "lambda_recon": 0.003,
  "lambda_sparse": 0.001,
  "lambda_dict": 0.0,
  "lambda_group": 0.01,
  "lambda_class": 0.0,
  "method": "group",
  "layer_specs": [
    {
      "dim": 16,
      "kernel": 7,
      "stride": 2,
      "T": 4,
      "prox": "on_sphere"
    },
    {
      "dim": 32,
      "kernel": 5,
      "stride": 1,
      "T": 4,
      "prox": "group_on_sphere"
    },
    {
      "dim": 128,
      "kernel": 7,
      "stride": 1,
      "T": 4,
      "prox": "group_on_sphere"
    }
  ],
  "base_model": "None"
}